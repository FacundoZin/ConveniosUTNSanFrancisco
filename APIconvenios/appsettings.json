{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // El usuario administrador inicial NO se configura aquí.
  // Definir obligatoriamente estas variables de entorno antes de arrancar la API:
  //   ADMIN_USER__NAME         => nombre de usuario del admin
  //   ADMIN_USER__PASSWORD     => contraseña del admin
  //   ADMIN_USER__DISPLAY_NAME => nombre para mostrar
}
